<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.jaimemoro.cornermanbox.ui.fragments.DashboardFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_training"
        android:name="com.jaimemoro.cornermanbox.ui.fragments.TrainingFragment"
        android:label="Entrenar"
        tools:layout="@layout/fragment_training" />

    <fragment
        android:id="@+id/navigation_library"
        android:name="com.jaimemoro.cornermanbox.ui.fragments.LibraryFragment"
        android:label="Técnica"
        tools:layout="@layout/fragment_library" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.jaimemoro.cornermanbox.ui.fragments.SettingsFragment"
        android:label="Ajustes"
        tools:layout="@layout/fragment_settings" />

</navigation>